{
  "manifest_version": 3,
  "name": "YouTube Clipper Cookie Connector",
  "version": "1.1.0",
  "description": "Import your own signed-in YouTube cookies into your private Clipper server.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "action": {
    "default_title": "Import YouTube login to Clipper",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "https://*.youtube.com/*",
    "https://youtube.com/*",
    "https://*/*"
  ]
}
