ANIMATION_STUDIO_HOST=127.0.0.1
ANIMATION_STUDIO_PORT=8789
# Optional project data directory:
# ANIMATION_STUDIO_DATA_DIR=/var/lib/sophie-animation-studio
# Optional executable overrides:
# PDFTOTEXT_PATH=/usr/bin/pdftotext
# FFMPEG_PATH=/usr/bin/ffmpeg
# Optional OpenAI-compatible image generation endpoint. Must return PNG as data[0].b64_json.
# Example endpoint shape: https://provider.example/v1/images/generations
# ANIMATION_IMAGE_PROVIDER_URL=
# ANIMATION_IMAGE_PROVIDER_KEY=
# ANIMATION_IMAGE_MODEL=
# ANIMATION_IMAGE_SIZE=1024x1024
# ANIMATION_IMAGE_TIMEOUT_MS=90000
# Story-planning adapter settings are reserved for a later increment:
# ANIMATION_STORY_PROVIDER_URL=
# ANIMATION_STORY_PROVIDER_KEY=
